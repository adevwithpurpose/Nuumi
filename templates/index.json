    "nuumi_faq": {
      "type": "nuumi-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Which product should I start with?",
            "answer": "<p>Start with whatever is making your dog's life hardest right now. If it's anxiety or restlessness, begin with CalmiCollar. If it's digestion, low energy, or tummy trouble, begin with Enercanis.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use more than one at the same time?",
            "answer": "<p>Yes - and most owners do. CalmiCollar works on stress, the training tools work on behavior, and Enercanis works on the gut. They each do a different job, so there's no conflict.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How quickly will I see results?",
            "answer": "<p>It depends on the product. With CalmiCollar, many owners notice a change in the first few days. Enercanis works on the gut, so most see a difference in energy and digestion within 2-3 weeks. Training results depend on staying consistent, but most owners see progress in the first week.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What if it doesn't work for my dog?",
            "answer": "<p>Every NuumiPet product comes with a money-back guarantee. If you don't see a difference, just reach out and we'll make it right. We'd rather you try it knowing the risk is on us.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Are the ingredients safe for all ages and breeds?",
            "answer": "<p>Yes. Every formula uses natural ingredients that are safe across breeds and life stages. If your dog has a medical condition or takes medication, it's always best to check with your vet first.</p>"
          }
        }
      },
